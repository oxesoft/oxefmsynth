BIN_DIR:=bin
EXECUTABLE_NAME:=oxefmsynth
VERSION_STR:=$(shell grep '\#define VERSION_STR' src/synth/constants.h | awk -F '"' '{print $$2}')

INCLUDES+=-Isrc/gui
INCLUDES+=-Isrc/synth
INCLUDES+=-Isrc/toolkits
INCLUDES+=-I.deps/blend2d -I.deps/blend2d/blend2d -I.deps/asmjit

CXXFLAGS+=-std=c++17 -DBL_STATIC
LDFLAGS+=-L.deps/blend2d/build -lblend2d -lpthread -lm

SOURCES+=src/toolkits/nonguitoolkit.cpp
SOURCES+=src/standalone/main.cpp
SOURCES+=src/gui/button.cpp
SOURCES+=src/gui/channels.cpp
SOURCES+=src/gui/editor.cpp
SOURCES+=src/gui/key.cpp
SOURCES+=src/gui/knob.cpp
SOURCES+=src/gui/lcd.cpp
SOURCES+=src/gui/mapper.cpp
SOURCES+=src/gui/font_data.cpp
SOURCES+=src/synth/buffers.cpp
SOURCES+=src/synth/delay.cpp
SOURCES+=src/synth/envelop.cpp
SOURCES+=src/synth/filter.cpp
SOURCES+=src/synth/noise.cpp
SOURCES+=src/synth/note.cpp
SOURCES+=src/synth/oscillator.cpp
SOURCES+=src/synth/persist.cpp
SOURCES+=src/synth/programs.cpp
SOURCES+=src/synth/reverb.cpp
SOURCES+=src/synth/synthesizer.cpp

UNAME_S:=$(shell uname -s)

ifeq ($(DEBUG),YES)
    CXXFLAGS+=-g -O0
else
    CXXFLAGS+=-O3
    ifneq ($(UNAME_S),Darwin)
        LDFLAGS+=-s
    endif
endif

ifeq ($(OS),Windows_NT)
    EXECUTABLE_NAME:=$(EXECUTABLE_NAME).exe
    CXX:=g++.exe
    RC:=windres.exe
    INCLUDES+=-Isrc/standalone
    SOURCES+=src/toolkits/windowstoolkit.cpp
    INCLUDES+=-Isrc/windows
    LDFLAGS+=-lgdi32
    LDFLAGS+=resources.o
    DEPS:=resources.o
    TARGET_FILE:=$(BIN_DIR)/$(EXECUTABLE_NAME)
else
    ifeq ($(TARGET),WIN32)
        EXECUTABLE_NAME:=$(EXECUTABLE_NAME).exe
        CXX:=i686-w64-mingw32-g++
        RC:=i686-w64-mingw32-windres
        INCLUDES+=-Isrc/standalone
        SOURCES+=src/toolkits/windowstoolkit.cpp
        INCLUDES+=-Isrc/windows
        LDFLAGS+=-lgdi32
        LDFLAGS+=resources.o
        DEPS:=resources.o
        LDFLAGS+=-static
        TARGET_FILE:=$(BIN_DIR)/$(EXECUTABLE_NAME)
    else
        INCLUDES+=-I.
        ifeq ($(UNAME_S),Darwin)
            ARCH_FLAGS?=-arch arm64 -arch x86_64
            CXXFLAGS+=$(ARCH_FLAGS)
            LDFLAGS+=$(ARCH_FLAGS) -framework Cocoa
            SOURCES+=src/toolkits/cocoatoolkit.mm
            TARGET_APP:=$(BIN_DIR)/$(EXECUTABLE_NAME).app
            TARGET_FILE:=$(TARGET_APP)/Contents/MacOS/$(EXECUTABLE_NAME)
        else
            LDFLAGS+=-lX11
            LDFLAGS+=-lpthread
            LDFLAGS+=-ldl
            SOURCES+=src/toolkits/xlibtoolkit.cpp
            TARGET_FILE:=$(BIN_DIR)/$(EXECUTABLE_NAME)
        endif
    endif
endif

BLEND2D_LIB?=.deps/blend2d/build/libblend2d.a

all: $(BLEND2D_LIB) $(DEPS)
ifeq ($(UNAME_S),Darwin)
	@mkdir -p $(TARGET_APP)/Contents/MacOS
	@$(CXX) -o $(TARGET_FILE) -DEXECUTABLE_NAME=\"$(EXECUTABLE_NAME)\" $(CXXFLAGS) $(SOURCES) $(INCLUDES) $(LDFLAGS)
	@cp src/macosx/app/PkgInfo $(TARGET_APP)/Contents/ 2>/dev/null || true
	@sed 's/__VERSION__/$(VERSION_STR)/g' src/macosx/app/Info.plist.in > $(TARGET_APP)/Contents/Info.plist
else
	@mkdir -p $(BIN_DIR)
	@$(CXX) -o $(TARGET_FILE) -DEXECUTABLE_NAME=\"$(EXECUTABLE_NAME)\" $(CXXFLAGS) $(SOURCES) $(INCLUDES) $(LDFLAGS)
endif
	@$(CMD)

ifeq ($(UNAME_S),Darwin)
$(BLEND2D_LIB):
	@echo "Downloading and building Blend2D (Universal)..."
	@mkdir -p .deps
	@if [ ! -d .deps/asmjit ]; then git clone --depth 1 https://github.com/asmjit/asmjit.git .deps/asmjit; fi
	@if [ ! -d .deps/blend2d ]; then git clone --depth 1 https://github.com/blend2d/blend2d.git .deps/blend2d; fi
	@cmake -B .deps/blend2d/build_arm64 -S .deps/blend2d -DCMAKE_BUILD_TYPE=Release -DBLEND2D_STATIC=TRUE -DCMAKE_OSX_ARCHITECTURES=arm64
	@cmake --build .deps/blend2d/build_arm64 --config Release
	@cmake -B .deps/blend2d/build_x86_64 -S .deps/blend2d -DCMAKE_BUILD_TYPE=Release -DBLEND2D_STATIC=TRUE -DCMAKE_OSX_ARCHITECTURES=x86_64
	@cmake --build .deps/blend2d/build_x86_64 --config Release
	@mkdir -p .deps/blend2d/build
	@lipo -create .deps/blend2d/build_arm64/libblend2d.a .deps/blend2d/build_x86_64/libblend2d.a -output .deps/blend2d/build/libblend2d.a
else
$(BLEND2D_LIB):
	@echo "Downloading and building Blend2D..."
	@mkdir -p .deps
	@if [ ! -d .deps/asmjit ]; then git clone --depth 1 https://github.com/asmjit/asmjit.git .deps/asmjit; fi
	@if [ ! -d .deps/blend2d ]; then git clone --depth 1 https://github.com/blend2d/blend2d.git .deps/blend2d; fi
	@cmake -B .deps/blend2d/build -S .deps/blend2d -DCMAKE_BUILD_TYPE=Release -DBLEND2D_STATIC=TRUE -DCMAKE_POSITION_INDEPENDENT_CODE=ON
	@cmake --build .deps/blend2d/build --config Release
endif

resources.o:
	@$(RC) -Isrc/synth -Isrc/windows src/windows/resources.rc resources.o

clean:
	@rm -rf $(BIN_DIR)/$(EXECUTABLE_NAME).app $(BIN_DIR)/$(EXECUTABLE_NAME) $(BIN_DIR)/$(EXECUTABLE_NAME).exe $(EXECUTABLE_NAME).app $(EXECUTABLE_NAME) *.o *.d
